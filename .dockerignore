# Version control, CI, IDE, and local agent metadata.
.git/
.github/
.dockerignore
.gitattributes
.gitignore
.idea/
.vscode/
.run/
.claude/
.agents/
.gitnexus/
AGENTS.md
CLAUDE.md

# Local configuration and credentials must never enter an image build context.
**/.env
**/*.env
*.cert
*.key
ops/

# Local build output, generated contract artifacts, and test-only sources.
bin/
dist/
*.out
common/proto/gen-openapi/
common/proto/gen-openapi-codex/
common/proto/gen-sdk/
common/proto/sdk/node_modules/
common/proto/sdk/.openapi-generator/
common/proto/sdk/.openapi-generator-cli/
**/*_test.go
**/testdata/
**/wire_gen.go
app/*/server
monolith/server
app/**/configs/ip2region/*.xdb
monolith/configs/ip2region/*.xdb

# Documentation, logs, and workstation files are not runtime build inputs.
README*
*.md
doc/
*.log
tmp/
.cache/
.DS_Store
Thumbs.db
