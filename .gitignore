# 参考 https://github.com/github/gitignore/blob/master/Go.gitignore
# 程序和插件二进制文件
*.exe
*.exe~
*.dll
*.dylib

# `go test -c` 构建出的测试二进制文件
*.test

# Go 覆盖率工具输出，尤其是 LiteIDE 使用时生成的文件
*.out

# 依赖目录
vendor/

# 编译产物、静态库、动态库
*.o
*.a
*.so

# 操作系统通用文件
Thumbs.db
.DS_Store

# 项目文件
*.cert
*.key
*.log
**/logs/
bin/

# 开发工具
.vscode/
.idea/
*.swp

# Proto 文档和 SDK 生成产物
/common/proto/gen-openapi/
/common/proto/gen-openapi-codex/
/common/proto/gen-sdk/
/common/proto/sdk/node_modules/
/common/proto/sdk/.openapi-generator/
/common/proto/sdk/.openapi-generator-cli/

# 模块生成产物
/app/**/wire_gen.go
/app/**/conf.pb.go
/app/**/gen/
/app/**/server
!/app/**/server/
/app/**/test/


/deploy/.prod.env

# AI 工具
.claude/
.gitnexus
.agents
