# PostgreSQL
BASS_POSTGRES_HOST=127.0.0.1
BASS_POSTGRES_PORT=5432
BASS_POSTGRES_USER=admin
BASS_POSTGRES_PASSWORD=123456
BASS_POSTGRES_DB=bass

# Redis
BASS_REDIS_HOST=127.0.0.1
BASS_REDIS_PORT=6379
BASS_REDIS_PASSWORD=123456

# RabbitMQ
BASS_RABBITMQ_HOST=127.0.0.1
BASS_RABBITMQ_PORT=5672
BASS_RABBITMQ_DEFAULT_USER=admin
BASS_RABBITMQ_DEFAULT_PASS=123456
BASS_RABBITMQ_DEFAULT_VHOST=admin_vhost

# Consul
BASS_CONSUL_HOST=127.0.0.1
BASS_CONSUL_PORT=8500
BASS_CONSUL_ACL_MASTER_TOKEN=35dbd953-7ef4-4563-aad5-d66868180631
BASS_CONSUL_ACL_APP_TOKEN=2f5ce384-adeb-bd77-2a26-0bb441ce2243

# bootstrap
BASS_SERVICE_MODE=dev
BASS_CONSUL_ADDR=127.0.0.1:8500
BASS_CONSUL_TOKEN=<PASSWORD>
BASS_LOG_LEVEL=debug
BASS_LOG_FILE=

# config
BASS_REGISTER_ADDRESS=127.0.0.1
