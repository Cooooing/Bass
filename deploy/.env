# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=123456
POSTGRES_DB=bass

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=123456

# RabbitMQ
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=123456
RABBITMQ_DEFAULT_VHOST=admin_vhost

# Consul
CONSUL_HOST=127.0.0.1
CONSUL_PORT=8500
CONSUL_ACL_MASTER_TOKEN=35dbd953-7ef4-4563-aad5-d66868180631
CONSUL_ACL_APP_TOKEN=35dbd953-7ef4-4563-aad5-d66868180631 # 微服务应用使用的 consul acl token, 部署时建议为每个应用生成不同权限范围的 token

# bootstrap
SERVICE_MODE=dev
LOG_LEVEL=debug
LOG_FILE=""

# config
REGISTER_ADDRESS="" # 服务本身地址，用于服务注册


