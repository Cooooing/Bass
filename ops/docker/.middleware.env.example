# Consul
CONSUL_HOST=consul
CONSUL_PORT=8500
CONSUL_ACL_MASTER_TOKEN=<FILL_CONSUL_MASTER_TOKEN>

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=bass
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<FILL_POSTGRES_PASSWORD>

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<FILL_REDIS_PASSWORD>

# NATS
NATS_HOST=nats
NATS_PORT=4222
NATS_CLUSTER_PORT=6222
NATS_MONITOR_PORT=8222
NATS_USER=<FILL_NATS_USER>
NATS_PASSWORD=<FILL_NATS_PASSWORD>

# MinIO
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=<FILL_MINIO_USER>
MINIO_ROOT_PASSWORD=<FILL_MINIO_PASSWORD>
MINIO_BUCKET=bass-assets
MINIO_API_CORS_ALLOW_ORIGIN=*
ASSET_EVENT_SUBJECT=storage.asset.object-created

# DTM
DTM_HTTP_PORT=36789
DTM_GRPC_PORT=36790
