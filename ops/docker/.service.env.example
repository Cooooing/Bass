# Bass Bootstrap configuration.
SERVICE_MODE=test
LOG_LEVEL=info
CONSUL_HOST=consul
CONSUL_PORT=8500
CONSUL_ACL_APP_TOKEN=<FILL_CONSUL_APP_TOKEN>

# Treble runtime configuration.
BBS_BFF_URL=<FILL_BBS_BFF_URL>
REALTIME_NODE_URL=<FILL_REALTIME_NODE_URL>
REDIS_URL=redis://:<FILL_REDIS_PASSWORD>@redis:6379/0
TREBLE_COOKIE_SECURE=true
