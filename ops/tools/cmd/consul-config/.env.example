# Consul synchronization
CONSUL_ADDRESS=127.0.0.1:8500
CONSUL_DATACENTER=dc1
CONSUL_PREFIX=config
CONSUL_TOKEN=<FILL_CONSUL_APP_TOKEN>

# Runtime and service endpoints
SERVICE_MODE=test
HTTP_HOST=0.0.0.0
HTTP_PORT=<FILL_SERVICE_HTTP_PORT>
GRPC_HOST=0.0.0.0
GRPC_PORT=<FILL_SERVICE_GRPC_PORT>
BFF_PUBLIC_URL=<FILL_BFF_PUBLIC_URL>
SITE_PUBLIC_URL=<FILL_SITE_PUBLIC_URL>

# Consul
CONSUL_HOST=consul
CONSUL_PORT=8500
CONSUL_ACL_APP_TOKEN=<FILL_CONSUL_APP_TOKEN>

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=bass
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<FILL_POSTGRES_PASSWORD>

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<FILL_REDIS_PASSWORD>

# NATS
NATS_HOST=nats
NATS_PORT=4222
NATS_USER=<FILL_NATS_USER>
NATS_PASSWORD=<FILL_NATS_PASSWORD>

# MinIO
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_BROWSER_ENDPOINT=http://127.0.0.1:9001
MINIO_BUCKET=bass-assets
MINIO_ROOT_USER=<FILL_MINIO_USER>
MINIO_ROOT_PASSWORD=<FILL_MINIO_PASSWORD>
MINIO_TIMEOUT=10s

# DTM
DTM_GRPC_ENDPOINT=dtm:36790

# Observability
OTEL_ENDPOINT=otel-collector:4317

# Asset events
ASSET_EVENT_SUBJECT=storage.asset.object-created
ASSET_EVENT_STREAM=asset_events
ASSET_EVENT_CONSUMER_DURABLE=platform_asset_events
ASSET_EVENT_ACK_WAIT=30s
ASSET_EVENT_MAX_ACK_PENDING=100

# Application security
USER_JWT_SECRET=<FILL_USER_JWT_SECRET>

# Email
EMAIL_SMTP_HOST=<FILL_EMAIL_SMTP_HOST>
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=<FILL_EMAIL_USERNAME>
EMAIL_PASSWORD=<FILL_EMAIL_PASSWORD>
EMAIL_FROM_EMAIL=<FILL_EMAIL_FROM_EMAIL>
EMAIL_FROM_NAME=<FILL_EMAIL_FROM_NAME>

# Lark
LARK_WEBHOOK_BASE_URL=<FILL_LARK_WEBHOOK_BASE_URL>
ALERT_LARK_BASE_URL=<FILL_ALERT_LARK_BASE_URL>
ALERT_LARK_TOKEN=<FILL_ALERT_LARK_TOKEN>
ALERT_LARK_SECRET=<FILL_ALERT_LARK_SECRET>

# Qiniu
QINIU_ACCESS_KEY=<FILL_QINIU_ACCESS_KEY>
QINIU_SECRET_KEY=<FILL_QINIU_SECRET_KEY>
QINIU_BUCKET=<FILL_QINIU_BUCKET>
QINIU_CALLBACK_URL=<FILL_QINIU_CALLBACK_URL>
QINIU_INCREMENT_AUDIT_CALLBACK_URL=<FILL_QINIU_INCREMENT_AUDIT_CALLBACK_URL>

# Tencent SMS
TENCENT_SMS_APP_ID=<FILL_TENCENT_SMS_APP_ID>
TENCENT_SMS_SECRET_ID=<FILL_TENCENT_SMS_SECRET_ID>
TENCENT_SMS_SECRET_KEY=<FILL_TENCENT_SMS_SECRET_KEY>
TENCENT_SMS_SIGN_NAME=<FILL_TENCENT_SMS_SIGN_NAME>
TENCENT_SMS_TEMPLATE_ID=<FILL_TENCENT_SMS_TEMPLATE_ID>
